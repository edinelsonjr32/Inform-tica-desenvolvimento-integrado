# SISCOPN — variáveis de ambiente
# Copie para .env e preencha com seus valores reais

# === Laravel (lidas por /api/.env também) ===
APP_NAME=SISCOPN
APP_ENV=local
APP_URL=http://localhost:8000

# === MySQL (container MySQL do docker-compose) ===
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=siscopn
DB_USERNAME=root
DB_PASSWORD=root

# === Cache e Session (FILE — não precisa Redis instalado) ===
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# === MailHog (container) ===
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@siscopn.local"
MAIL_FROM_NAME="SISCOPN"

# === Expo / React Native ===
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_APP_NAME="SISCOPN"

# === ngrok ===
# Cadastre-se grátis em https://dashboard.ngrok.com/signup
# Copie seu authtoken em https://dashboard.ngrok.com/get-started/your-authtoken
# O setup.sh (etapa 13) lê este valor e configura o ngrok automaticamente.
NGROK_AUTHTOKEN=3HLDQuVHjG6ipvoS1fyxWuxjanH_5SMmMoNbFSYh2BnPJZ57s
